{
  "enabledMcpjsonServers": [
    "meta-inbox"
  ],
  "permissions": {
    "allow": [
      "mcp__meta-inbox__check_access",
      "mcp__meta-inbox__list_conversations",
      "mcp__meta-inbox__get_conversation",
      "mcp__meta-inbox__list_messages",
      "mcp__meta-inbox__get_message",
      "mcp__meta-inbox__list_posts",
      "mcp__meta-inbox__list_comments",
      "mcp__meta-inbox__get_comment",
      "mcp__meta-inbox__send_message",
      "mcp__meta-inbox__send_sender_action",
      "mcp__meta-inbox__private_reply",
      "mcp__meta-inbox__reply_to_comment",
      "mcp__meta-inbox__create_comment",
      "mcp__meta-inbox__update_comment",
      "mcp__meta-inbox__hide_comment",
      "WebSearch",
      "WebFetch",
      "mcp__claude-in-chrome",
      "mcp__Gmail__search_threads",
      "mcp__Gmail__get_thread",
      "mcp__Gmail__get_message",
      "mcp__Gmail__list_drafts",
